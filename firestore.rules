rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ──────────────────────────────────────────────
    // Admins can list all users; regular users can only access their own doc.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Managers (dashboard admin login + management) ──────
    match /managers/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Categories ─────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Bank Rates / Profit Margins ───────────────────────
    // profit_margins يُقرأ عاماً: صفحة هوامش الربح (hawawem-arbach) تعمل
    // داخل WebView التطبيق بدون جلسة Firebase Auth.
    match /bank_rates/{docId} {
      allow read: if docId == 'profit_margins' || request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Bank Margins Scraper (صفحات bank-margins / margins-compare العامة) ──
    // القراءة عامة لأن الصفحات تعمل بدون مصادقة؛ الكتابة من Cloud Functions
    // (Admin SDK يتجاوز القواعد) أو من الداشبورد بمصادقة.
    match /bank_margins/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /grok_margins/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /scraper_meta/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── App Notifications ─────────────────────────────────
    match /app_notifications/{notifId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;

      match /acknowledgments/{ackId} {
        allow read, write: if request.auth != null;
      }
    }

    // ── AI Config ─────────────────────────────────────────
    match /ai_config/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── AI Conversations ──────────────────────────────────
    match /ai_conversations/{convId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── App Config / Pages ────────────────────────────────
    match /app_config/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Tools ─────────────────────────────────────────────
    match /tools/{toolId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Stats (web visits / logins counter) ──────────────
    match /stats/web {
      allow read: if request.auth != null;
      allow write: if request.resource.data.keys().hasOnly(['visitCount', 'loginCount']);
    }

    // ── إحصاءات التطبيق: نشاط المستخدمين وعدّادات زيارات الصفحات ──────
    // تُكتب من صفحات المنتجات (HTML) داخل التطبيق، وهي صفحات عامة بلا
    // مصادقة — لذا الكتابة مسموحة لكن مقيّدة بأسماء الحقول فقط (نفس نمط
    // stats/web أعلاه)، والقراءة محصورة بالداشبورد (مستخدم مسجّل).
    // product_activity: مستند لكل زائر يحمل آخر فتح (lastOpenAt).
    match /product_activity/{visitorId} {
      allow read: if request.auth != null;
      allow write: if request.resource.data.keys().hasOnly(['lastOpenAt']);
    }
    // product_stats: عدّاد زيارات لكل صفحة/منتج.
    match /product_stats/{pageId} {
      allow read: if request.auth != null;
      allow write: if request.resource.data.keys()
                     .hasOnly(['views', 'nameAr', 'nameEn', 'lastOpenAt']);
    }
  }
}
